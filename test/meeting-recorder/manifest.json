{
  "manifest_version": 3,
  "name": "Meeting Transcript Recorder",
  "version": "1.0",
  "description": "Ghi lại nội dung cuộc họp và xuất file .txt",
  "permissions": [
    "sidePanel",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Meeting Recorder"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*"
  ]
}
